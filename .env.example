# Spotify — https://developer.spotify.com/dashboard
# Redirect URI must use 127.0.0.1, NOT localhost (Spotify rejects localhost).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Google — https://console.cloud.google.com/apis/credentials
# Create an OAuth client of type "Desktop app", download the JSON, point here.
# Enable the "YouTube Data API v3" for the project.
GOOGLE_CLIENT_SECRETS_FILE=./.data/google_client_secret.json

# official  = YouTube Data API (safe, ~198 tracks/day quota ceiling)
# ytmusicapi = unofficial client (no ceiling, requires browser auth headers)
YT_WRITE_MODE=official

# Local state (token caches, sqlite). Git-ignored.
DATA_DIR=./.data
